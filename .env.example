# --- ProjectX (TopstepX) ---
PROJECTX_USERNAME=
PROJECTX_API_KEY=
PROJECTX_BASE_URL=https://api.topstepx.com
PROJECTX_USER_HUB=https://rtc.topstepx.com/hubs/user
PROJECTX_MARKET_HUB=https://rtc.topstepx.com/hubs/market
PROJECTX_ACCOUNT_ID=

# --- Eval profile ---
ACME_EVAL_PROFILE=topstep_50k
ACME_LIVE=false

# --- Contract overrides ---
ACME_MES_OVERRIDE=

# --- Scheduler ---
ACME_TZ=America/Chicago
# Topstep enforces a hard 15:10 CT close; flatten at 14:55 gives a 15-min buffer
ACME_FLATTEN_HHMM=14:55
# Topstep allows resume at 17:00 CT; wait until 17:05 (5-min buffer)
ACME_RESUME_HHMM=17:05
# Daytime trade window (overnight is permitted by Topstep but disabled in Phase A)
ACME_TRADE_WINDOW_START=08:30
ACME_TRADE_WINDOW_END=14:45

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
