<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.acme-futures.runner</string>

    <!-- 2026-05-05 macOS TCC tightened — launchd refuses to posix_spawn
         user-installed binaries (caffeinate, uv) directly. We invoke
         /bin/sh (system, always permitted) and let it exec uv. The
         spawn-permission gate is at launchd level only; once sh is
         running it can exec anything the user can.
         To switch to live trading, drop the --dry-run flag from the -c arg. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /Users/ryanmurphy/.local/bin/uv run python -m acme.runner --dry-run</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/ryanmurphy/Desktop/Acme Futures</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/ryanmurphy/.local/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/ryanmurphy</string>
    </dict>

    <!-- Start automatically when you log in. -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Restart automatically if the process crashes. ThrottleInterval prevents
         a fast crash loop from spinning the CPU; minimum 60 seconds between restarts. -->
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <!-- Logs — tail these to see what the runner is doing. -->
    <key>StandardOutPath</key>
    <string>/Users/ryanmurphy/Desktop/Acme Futures/logs/runner.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ryanmurphy/Desktop/Acme Futures/logs/runner.err.log</string>

    <!-- Run as the logged-in user (not root). LaunchAgents do this by default
         since they live in ~/Library/LaunchAgents, but being explicit. -->
    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
