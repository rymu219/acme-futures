{
  "$schema": "https://schema.railpack.com",
  "providers": ["python"],
  "packages": {
    "python": "3.11"
  },
  "steps": {
    "install": {
      "commands": [
        "python -m pip install --upgrade pip",
        "python -m pip install -r web/requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "uvicorn app:app --app-dir web --host 0.0.0.0 --port $PORT",
    "inputs": [
      { "step": "install" }
    ]
  }
}
